{
  "buildCommand": "vite build --config client/vite.config.ts",
  "outputDirectory": "dist/client",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://sikapos.onrender.com/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
