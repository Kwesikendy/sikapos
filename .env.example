# SikaPOS / Akoma Commerce Cloud Environment Configuration
# Node Environment: development | test | production
NODE_ENV=development

# Server Port and Host
PORT=3000
HOST=0.0.0.0

# Database Configuration
# Local SQLite database file path (or :memory: for testing)
DATABASE_PATH=./data/sikapos.db

# Authentication & Security
# Cryptographic session token secret (change in production)
SESSION_SECRET=dev-sikapos-secret-key-change-in-production-min32chars
SESSION_EXPIRY_HOURS=24

# OTP Provider: sandbox | log | mock
# Note: External telco providers (MTN/Telecel/AT) are decoupled and require explicit production adapters in later phases.
OTP_PROVIDER=sandbox

# CORS allowed origins
CORS_ORIGIN=*

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
